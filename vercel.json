{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "vercel-proxy",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "https://socle-v2-production-4c91.up.railway.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
